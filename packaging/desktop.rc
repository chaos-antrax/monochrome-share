        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Monochrome - Share"
            VALUE "ProductName", "Monochrome - Share"
            VALUE "FileVersion", "0.1.1"
            VALUE "ProductVersion", "0.1.1"
            VALUE "InternalName", "desktop"
            VALUE "OriginalFilename", "desktop.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
